# TMDB v4 "API Read Access Token" (themoviedb.org > Settings > API). Server only.
TMDB_READ_TOKEN=

# Supabase project. The service role key is server only. Never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random 32+ character string. Used to hash IP addresses before they are stored.
HASH_SALT=

# Public origin with no trailing slash, e.g. https://my10films.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Address shown on the credits page for takedown and contact requests.
NEXT_PUBLIC_CONTACT_EMAIL=
